# Modelo de variaveis de ambiente do projeto.
# Copie este arquivo para ".env" (na raiz, ao lado do pom.xml) e preencha os valores localmente.
# ".env" nao deve ser versionado.

# integracao.brapi.token - token da Brapi (https://brapi.dev) usado para cotacoes de acoes do mercado BRASIL
BRAPI_TOKEN=

# integracao.alphavantage.api-key - API key da Alpha Vantage (https://www.alphavantage.co) usada para cotacoes de acoes do mercado EUA
ALPHAVANTAGE_API_KEY=

# Usados apenas quando spring.profiles.active=mysql ou postgresql (o perfil padrao do projeto e h2, que nao precisa destas variaveis)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
